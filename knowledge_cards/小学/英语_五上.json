          "difficulty": 3,
          "importance": 5,
          "definition": "学习如何询问一个人的性格或外貌特点，并用形容词进行描述。",
          "core_points": [
            "What's he/she like? 他/她怎么样？ (询问性格或特点)",
            "He's/She's kind/strict/funny. 他/她很和蔼/严格/有趣。",
            "What do you think of...? 你觉得……怎么样？",
            "I think he/she is... 我觉得他/她很……"
          ],
          "example": {
            "question": "你的新英语老师怎么样？用英语说一说。",
            "steps": [
              "思考老师的特点 (如：kind, funny)",
              "使用句型 'My English teacher is...' 或 'I think she is...'"
            ],
            "answer": "My English teacher is kind and funny."
          },
          "mistakes": [
            {
              "wrong": "What is he like?",
              "correct": "What's he like?"
            },
            {
              "wrong": "She is like kind.",
              "correct": "She is kind."
            }
          ],
          "memory_tip": "What's ... like? 问的是'像什么样'，也就是'怎么样'。回答时直接用be动词加形容词。",
          "related": {
            "prerequisite": "形容词词汇",
            "next": "描述更复杂的个人信息"
          }
        }
      ]
