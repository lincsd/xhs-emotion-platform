          "title": "面积和面积单位",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "面积就是图形表面的大小。常用单位：平方厘米（cm²）、平方分米（dm²）、平方米（m²）。",
          "core_points": [
            "面积和周长不一样：周长是边的长度，面积是面的大小",
            "长方形面积 = 长 × 宽",
            "正方形面积 = 边长 × 边长",
            "1平方米 = 100平方分米 = 10000平方厘米"
          ],
          "example": {
            "question": "一个长方形长6厘米，宽4厘米，面积多少？",
            "steps": ["面积 = 长 × 宽", "= 6 × 4 = 24"],
            "answer": "面积是24平方厘米"
          },
          "mistakes": [
            {"wrong": "面积和周长公式搞混", "correct": "周长=边之和（加法），面积=长×宽（乘法）"},
            {"wrong": "面积单位写成「厘米」", "correct": "面积单位要加「平方」：平方厘米、平方米"}
          ],
          "memory_tip": "📐 周长是围栅栏（围一圈），面积是铺地砖（铺满里面）",
          "related": {"prerequisite": "见三上 周长", "next": "见五上 多边形面积"}
        }
      ]
    },
    {
      "unit_id": "S4",
      "unit_name": "年月日",
      "cards": [
        {
          "card_id": "S4-01",
          "full_id": "数学-三下-S4-01",
          "title": "年月日的知识",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 4,
          "definition": "一年有12个月。大月31天，小月30天，二月特殊（平年28天，闰年29天）。",
          "core_points": [
            "大月（31天）：1、3、5、7、8、10、12月",
            "小月（30天）：4、6、9、11月",
            "平年365天（二月28天），闰年366天（二月29天）",
            "闰年判断：年份÷4=0且÷100≠0，或÷400=0"
          ],
          "example": {
            "question": "2024年是平年还是闰年？",
            "steps": ["2024÷4=506，能整除", "2024÷100=20.24，不能整除", "满足条件"],
            "answer": "2024年是闰年"
          },
          "mistakes": [
            {"wrong": "把7月和8月当成一大一小", "correct": "7月和8月都是大月，连着两个31天"},
            {"wrong": "1900年是闰年（能被4整除）", "correct": "1900÷100=19能整除，但÷400不能，所以是平年"}
          ],
          "memory_tip": "✊ 拳头记大小月：拳头骨节凸起的是大月（31天），凹下去的是小月（30天），二月特殊跳过",
          "related": {"prerequisite": "时间认识", "next": "见24时计时法"}
        }
      ]
    },
