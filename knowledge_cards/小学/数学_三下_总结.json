      "unit_id": "S1",
      "unit_name": "除数是一位数的除法",
      "cards": [
        {
          "card_id": "S1-01",
          "full_id": "数学-三下-S1-01",
          "title": "除数是一位数的笔算除法",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "除数是一位数的除法笔算：从被除数的最高位除起，一位一位往右除。",
          "core_points": [
            "从最高位开始除：852÷4，先算8÷4=2",
            "够除就商几，不够除就和下一位合起来",
            "每次余数都比除数小",
            "商中间或末尾可能有0，不能漏写"
          ],
          "example": {
            "question": "816÷4=？",
            "steps": ["百位：8÷4=2，写2", "十位：1÷4不够商，写0，和下一位合起来", "个位：16÷4=4"],
            "answer": "816÷4=204"
          },
          "mistakes": [
            {"wrong": "商的中间漏了0：816÷4=24", "correct": "十位不够除要写0占位：816÷4=204"},
            {"wrong": "从个位开始除", "correct": "除法从最高位开始！（和加减法相反）"}
          ],
          "memory_tip": "📖 除法像看书：从左往右，一位一位来，不够就合并下一位",
          "related": {"prerequisite": "见三上 有余数除法", "next": "见四下 除数是两位数除法"}
        }
      ]
    },
    {
      "unit_id": "S2",
      "unit_name": "两位数乘两位数",
      "cards": [
        {
          "card_id": "S2-01",
          "full_id": "数学-三下-S2-01",
          "title": "两位数乘两位数的竖式",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "两位数乘两位数：先用个位乘，再用十位乘（写在第二行要左移一位），最后两行相加。",
          "core_points": [
            "第一步：用第二个数的个位去乘第一个数",
            "第二步：用第二个数的十位去乘第一个数（要左移一位）",
            "第三步：把两次的积加起来",
            "左移一位是因为十位表示几个十"
          ],
          "example": {
            "question": "23×12=？",
            "steps": ["23×2=46（个位乘）", "23×1=23（十位乘，左移一位写230）", "46+230=276"],
            "answer": "23×12=276"
          },
          "mistakes": [
            {"wrong": "第二行不左移一位", "correct": "十位乘的结果要左移一位（相当于×10）"},
            {"wrong": "两行积相加算错", "correct": "相加时也要对齐数位，小心进位"}
          ],
          "memory_tip": "✖️ 两位乘两位像分身术：先和个位打，再和十位打（退一步），最后合体！",
          "related": {"prerequisite": "见三上 多位数乘一位数", "next": "见四上 三位数乘两位数"}
        }
      ]
    },
    {
