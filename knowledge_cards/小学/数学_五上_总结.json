      "unit_name": "简易方程",
      "cards": [
        {
          "card_id": "S2-01",
          "full_id": "数学-五上-S2-01",
          "title": "用字母表示数与方程",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "方程就是含有未知数的等式。解方程就是求出未知数x等于多少，让等式成立。",
          "core_points": [
            "用字母表示数：a+b表示两数之和",
            "方程 = 含有未知数的等式",
            "等式性质：两边同时加减乘除同一个数，等式仍成立",
            "解方程的目标：把x移到一边，数字移到另一边"
          ],
          "example": {
            "question": "解方程：3x+5=20",
            "steps": ["两边同时减5：3x=15", "两边同时除以3：x=5", "验算：3×5+5=20 ✓"],
            "answer": "x=5"
          },
          "mistakes": [
            {"wrong": "移项不变号：x+5=20 → x=20+5", "correct": "移到另一边要变号：x=20-5=15"},
            {"wrong": "忘记验算", "correct": "把答案代入原方程检验是否成立"}
          ],
          "memory_tip": "⚖️ 方程像天平：两边必须平衡，你在左边加什么，右边也要加什么",
          "related": {"prerequisite": "四则运算", "next": "见六上 比"}
        }
      ]
    },
    {
      "unit_id": "S3",
      "unit_name": "多边形的面积",
      "cards": [
        {
          "card_id": "S3-01",
          "full_id": "数学-五上-S3-01",
          "title": "平行四边形、三角形、梯形面积",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "三种常见多边形面积公式：平行四边形=底×高，三角形=底×高÷2，梯形=(上底+下底)×高÷2。",
          "core_points": [
            "平行四边形面积 = 底 × 高",
            "三角形面积 = 底 × 高 ÷ 2",
            "梯形面积 = (上底+下底) × 高 ÷ 2",
            "高一定是垂直于底的线段（不是斜边）"
          ],
          "example": {
            "question": "一个梯形，上底3cm，下底7cm，高4cm，面积是多少？",
            "steps": ["面积=(上底+下底)×高÷2", "=(3+7)×4÷2", "=10×4÷2=20"],
            "answer": "面积是20平方厘米"
          },
          "mistakes": [
            {"wrong": "三角形面积忘了÷2", "correct": "三角形是平行四边形的一半，必须÷2"},
            {"wrong": "梯形只用一个底乘高", "correct": "梯形有两个底，要先加起来再乘高÷2"},
            {"wrong": "把斜边当成高", "correct": "高必须与底垂直"}
          ],
          "memory_tip": "📐 面积公式顺口溜：平行四边底×高，三角形要除以2，梯形上下底相加再乘高除以2",
          "related": {"prerequisite": "见三下 面积", "next": "见六上 圆的面积"}
        }
      ]
    },
