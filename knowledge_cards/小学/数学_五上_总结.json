      "cards": [
        {
          "card_id": "S1-01",
          "full_id": "数学-五上-S1-01",
          "title": "小数乘法",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "小数乘法：先按整数乘，再数两个因数一共有几位小数，积就点几位小数。",
          "core_points": [
            "小数乘整数：先忽略小数点按整数算，再点回小数点",
            "小数乘小数：两个因数小数位数之和 = 积的小数位数",
            "0.3×0.2=0.06（1位+1位=2位小数）",
            "积末尾有0先点小数点再化简"
          ],
          "example": {
            "question": "2.5×0.4=？",
            "steps": ["当成整数：25×4=100", "小数位数：1位+1位=2位", "100点2位小数→1.00=1"],
            "answer": "2.5×0.4=1"
          },
          "mistakes": [
            {"wrong": "2.5×0.4=10.0（小数点放错）", "correct": "共2位小数，100→1.00=1"},
            {"wrong": "先点小数点再消0", "correct": "先消0再点小数点是错的，要先数好位数再点"}
          ],
          "memory_tip": "🔢 小数乘法三步走：①忽略小数点算 ②数小数位数 ③从右往左点小数点",
          "related": {"prerequisite": "见四下 小数", "next": "见S1-02 小数除法"}
        },
        {
          "card_id": "S1-02",
          "full_id": "数学-五上-S1-02",
          "title": "小数除法",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "小数除法的关键：先把除数变成整数！除数小数点移几位，被除数也移几位。",
          "core_points": [
            "除数是小数→先变成整数：1.2÷0.3 → 12÷3",
            "除数和被除数同时移动相同位数",
            "商的小数点和被除数（移动后的）对齐",
            "除不尽可以在被除数后面添0继续除"
          ],
          "example": {
            "question": "7.2÷0.6=？",
            "steps": ["除数0.6变成整数6（移1位）", "被除数7.2也移1位→72", "72÷6=12"],
            "answer": "7.2÷0.6=12"
          },
          "mistakes": [
            {"wrong": "只移动除数的小数点", "correct": "除数和被除数要同时移动相同位数"},
            {"wrong": "商的小数点位置放错", "correct": "商的小数点对齐移动后的被除数的小数点"}
          ],
          "memory_tip": "🎢 小数除法像搬家：除数要搬到整数区（移小数点），被除数也要跟着一起搬",
          "related": {"prerequisite": "见S1-01 小数乘法", "next": "见S1-03 循环小数"}
        },
        {
          "card_id": "S1-03",
          "full_id": "数学-五上-S1-03",
          "title": "循环小数与近似值",
          "type": "知识总结卡",
          "difficulty": 3,
          "importance": 4,
          "definition": "有的除法永远除不尽，小数部分会重复出现，叫循环小数。如1÷3=0.333...=0.3̇。",
          "core_points": [
            "循环小数：小数部分某些数字不断重复",
            "循环节：重复的那组数字，如0.333...的循环节是3",
            "有限小数：小数位数有限（能除尽）",
            "无限小数：小数位无限（除不尽），循环小数是一种"
          ],
          "example": {
            "question": "10÷3=？（保留两位小数）",
            "steps": ["10÷3=3.333...", "看第三位小数：3", "3<5四舍"],
            "answer": "≈3.33"
          },
          "mistakes": [
            {"wrong": "循环小数不会取近似值", "correct": "看保留位的下一位，用四舍五入"},
            {"wrong": "以为所有除法都能除尽", "correct": "很多除法会产生无限循环小数"}
          ],
          "memory_tip": "🔄 循环小数就像跑圈的小人：一直跑一直跑，永远停不下来",
          "related": {"prerequisite": "小数除法", "next": "见四舍五入"}
        }
      ]
    },
    {
