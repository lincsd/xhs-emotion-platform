      "unit_name": "100以内数的认识",
      "cards": [
        {
          "card_id": "S1-01",
          "full_id": "数学-一下-S1-01",
          "title": "认识十位和个位：两位数的秘密",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "两位数有两个位置：十位和个位。十位上的数表示几个十，个位上的数表示几个一。",
          "core_points": [
            "一个十就是10，两个十就是20",
            "35 = 3个十 + 5个一，十位是3，个位是5",
            "10个一 = 1个十，这叫「满十进一」",
            "最小的两位数是10，最大的两位数是99"
          ],
          "example": {
            "question": "数字47里有几个十、几个一？",
            "steps": ["十位上是4 → 4个十", "个位上是7 → 7个一"],
            "answer": "4个十和7个一"
          },
          "mistakes": [
            {"wrong": "把十位和个位搞反：35的十位是5", "correct": "从右往左，第一位是个位(5)，第二位是十位(3)"},
            {"wrong": "认为100是两位数", "correct": "100是三位数（最小的三位数）"}
          ],
          "memory_tip": "💡 个位住一楼（表示几个一），十位住二楼（表示几个十）",
          "related": {"prerequisite": "见一上 认识1-10", "next": "见S1-02 数的顺序"}
        },
        {
          "card_id": "S1-02",
          "full_id": "数学-一下-S1-02",
          "title": "数的顺序和大小比较",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "比较两位数的大小：先看十位，十位大的那个数就大；十位一样，再看个位。",
          "core_points": [
            "比大小先看十位：52 > 38（因为5>3）",
            "十位相同看个位：45 < 48（因为5<8）",
            "从小到大排列叫升序，从大到小叫降序",
            "两个数之间的数：36和38之间是37"
          ],
          "example": {
            "question": "63 ○ 67，填 > < 还是 =？",
            "steps": ["十位都是6，一样大", "看个位：3 < 7"],
            "answer": "63 < 67"
          },
          "mistakes": [
            {"wrong": "只看个位不看十位", "correct": "一定先比十位！十位大的数就大"},
            {"wrong": "28 > 31（因为8>1）", "correct": "28 < 31，因为十位2<3"}
          ],
          "memory_tip": "🏢 比身高先比楼层（十位），同一层再比房间号（个位）",
          "related": {"prerequisite": "见S1-01 十位和个位", "next": "见S2-01 退位减法"}
        }
      ]
    },
    {
      "unit_id": "S2",
      "unit_name": "20以内退位减法",
      "cards": [
        {
          "card_id": "S2-01",
          "full_id": "数学-一下-S2-01",
          "title": "破十法：退位减法的好帮手",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "算13-8这种退位减法，个位不够减怎么办？把十位上的1个十拆开变成10个一，再减！",
          "core_points": [
            "破十法：先把十位拆开，用10减去减数，再加个位",
            "13-8：10-8=2，2+3=5",
            "15-7：10-7=3，3+5=8",
            "口诀：个位不够找十位借"
          ],
          "example": {
            "question": "算一算：12-5=？",
            "steps": ["个位2不够减5", "从十位借1个十：10-5=5", "5+2=7"],
            "answer": "12-5=7"
          },
          "mistakes": [
            {"wrong": "12-5=3（只用个位算）", "correct": "要借十位的10来减：10-5=5，5+2=7"},
            {"wrong": "忘记加回个位上的数", "correct": "破十法最后一步别忘了加个位"}
          ],
          "memory_tip": "🔟 破十法 = 十位借兵：借10来减，剩下的再和个位会合！",
          "related": {"prerequisite": "见一上 凑十法", "next": "见S3-01 加减法"}
        }
      ]
    },
    {
      "unit_id": "S3",
      "unit_name": "100以内加减法",
      "cards": [
        {
          "card_id": "S3-01",
          "full_id": "数学-一下-S3-01",
          "title": "整十数加减法",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "整十数（10、20、30...）的加减法很简单，只要算十位就行！",
          "core_points": [
            "30+40：3个十+4个十=7个十=70",
            "80-50：8个十-5个十=3个十=30",
            "只看十位上的数字做加减就行",
            "别忘了结果后面要写0"
          ],
          "example": {
            "question": "50+30=？",
            "steps": ["5个十+3个十=8个十", "8个十=80"],
            "answer": "50+30=80"
          },
          "mistakes": [
            {"wrong": "50+30=53", "correct": "50+30=80，是十位相加，不是拼在一起"},
            {"wrong": "结果忘写0：50+30=8", "correct": "8个十=80，别丢了0！"}
          ],
          "memory_tip": "🔢 整十加减：蒙住所有0，只算前面的数字，算完再把0加回来",
          "related": {"prerequisite": "见S1-01 十位个位", "next": "见S3-02 两位数加减"}
        },
        {
          "card_id": "S3-02",
          "full_id": "数学-一下-S3-02",
          "title": "两位数加减一位数、整十数",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "两位数加减：个位加个位，十位加十位。记住：相同数位的数才能加减！",
          "core_points": [
            "35+2=37（个位加个位：5+2=7）",
            "35+20=55（十位加十位：3+2=5）",
            "46-3=43（个位减个位：6-3=3）",
            "46-20=26（十位减十位：4-2=2）"
          ],
          "example": {
            "question": "56+30=？",
            "steps": ["30是整十数，加十位", "十位：5+3=8，个位不变：6", "结果=86"],
            "answer": "56+30=86"
          },
          "mistakes": [
            {"wrong": "35+20=37（把20当成2）", "correct": "20是2个十，加在十位上：3+2=5，结果55"},
            {"wrong": "混淆加个位还是加十位", "correct": "加一位数→加个位；加整十数→加十位"}
          ],
          "memory_tip": "🏠 个位找个位玩，十位找十位玩，不能串门！",
          "related": {"prerequisite": "见S3-01 整十数加减", "next": "见二上 竖式计算"}
        }
      ]
    },
    {
      "unit_id": "S4",
      "unit_name": "认识图形与人民币",
      "cards": [
        {
          "card_id": "S4-01",
          "full_id": "数学-一下-S4-01",
          "title": "认识平面图形",
          "type": "知识总结卡",
          "difficulty": 1,
          "importance": 4,
          "definition": "平面图形就是「扁扁的」图形，画在纸上的。常见的有：长方形、正方形、三角形、圆。",
          "core_points": [
            "长方形：4条边，对边相等，4个角都是直角",
            "正方形：4条边都一样长，4个角都是直角",
            "三角形：3条边，3个角",
            "圆：弯弯的一条线围成的，没有角"
          ],
          "example": {
            "question": "课本的封面是什么形状？",
            "steps": ["课本封面有4条边", "对边一样长，但不是4条都一样长", "4个角都是直角"],
            "answer": "长方形"
          },
          "mistakes": [
            {"wrong": "把正方形和长方形搞混", "correct": "正方形4条边都一样长，长方形只有对边一样长"},
            {"wrong": "忘记圆没有角", "correct": "圆是唯一没有角的平面图形"}
          ],
          "memory_tip": "📐 正方形像窗户（4边等长），长方形像门（对边等长），△ 像屋顶，○ 像太阳",
          "related": {"prerequisite": "见一上 立体图形", "next": "见二上 角的认识"}
        },
        {
          "card_id": "S4-02",
          "full_id": "数学-一下-S4-02",
          "title": "人民币：元角分的换算",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 4,
          "definition": "人民币的单位有元、角、分。1元=10角，1角=10分，1元=100分。",
          "core_points": [
            "1元 = 10角 = 100分",
            "1角 = 10分",
            "换算口诀：大单位变小单位要乘10",
            "买东西找零：付的钱 - 价格 = 找回的钱"
          ],
          "example": {
            "question": "一块橡皮8角，给1元钱，应找回多少？",
            "steps": ["1元 = 10角", "10角 - 8角 = 2角"],
            "answer": "应找回2角"
          },
          "mistakes": [
            {"wrong": "1元=10分", "correct": "1元=10角=100分，别跳级"},
            {"wrong": "3元5角写成3.50元", "correct": "3元5角=3.5元（3元50分=3.50元），注意区别"}
          ],
          "memory_tip": "💰 元角分就像百十个位：元是老大（最大），分是小弟（最小），中间是角",
          "related": {"prerequisite": "见S1-01 十位个位", "next": "见二下 克和千克"}
        }
      ]
    },
    {
      "unit_id": "S5",
      "unit_name": "找规律",
      "cards": [
        {
          "card_id": "S5-01",
          "full_id": "数学-一下-S5-01",
          "title": "找规律：发现重复的秘密",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 4,
          "definition": "找规律就是发现事物重复出现的顺序。找到一组重复的「单元」，就能预测后面是什么。",
          "core_points": [
            "先找重复的一组：🔴🔵🔴🔵... → 重复的是🔴🔵",
            "数字规律：2,4,6,8... → 每次+2",
            "图形规律：△○□△○□... → 重复的是△○□",
            "找到规律后，就能推出下一个是什么"
          ],
          "example": {
            "question": "1,3,5,7,___,___",
            "steps": ["看相邻两个数的差：3-1=2，5-3=2，7-5=2", "每次加2"],
            "answer": "9, 11"
          },
          "mistakes": [
            {"wrong": "只看前面两个就下结论", "correct": "至少看3-4个数或图形，确认规律成立"},
            {"wrong": "把每次+2的规律看成×2", "correct": "仔细算差值，不要猜"}
          ],
          "memory_tip": "🔍 找规律就像当侦探：找到重复的「密码」，就能破解整个序列！",
          "related": {"prerequisite": "数的顺序", "next": "见二下 找规律（进阶）"}
        }
      ]
    }
  ]
