        {
          "card_id": "S2-01",
          "full_id": "数学-二上-S2-01",
          "title": "竖式计算：加减法的好帮手",
          "type": "知识总结卡",
          "difficulty": 2,
          "importance": 5,
          "definition": "竖式就是把数字上下对齐一位一位算。记住：相同数位要对齐，从个位算起！",
          "core_points": [
            "竖式三步骤：对齐→算个位→算十位",
            "加法进位：个位相加满10，向十位进1",
            "减法退位：个位不够减，从十位借1当10",
            "计算完要验算：加法用减法验算，减法用加法验算"
          ],
          "example": {
            "question": "用竖式算 56+37=？",
            "steps": ["个位：6+7=13，写3进1", "十位：5+3=8，加上进来的1=9"],
            "answer": "56+37=93"
          },
          "mistakes": [
            {"wrong": "个位进1忘了加到十位", "correct": "进位的1一定要加上去！"},
            {"wrong": "数位没对齐导致算错", "correct": "个位对个位，十位对十位，竖线拉直"}
          ],
          "memory_tip": "📝 竖式就像排队：大家站整齐，个位排个位队，十位排十位队",
          "related": {"prerequisite": "见一下 两位数加减", "next": "见三上万以内加减法"}
        }
      ]
    },
