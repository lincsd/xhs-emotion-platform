        {
          "card_id": "T1-01",
          "full_id": "数学-三下-T1-01",
          "title": "0÷5和5÷0",
          "type": "陷阱卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "0除以任何非零数等于0；任何数不能除以0",
          "core_points": [
            "0÷5=0（0个东西分5份，每份还是0）",
            "5÷0无意义（不能把5分成0份）",
            "混淆这两个是最常见的错误"
          ],
          "example": {
            "question": "计算：0÷5=？和5÷0=？",
            "steps": [
              "0÷5：0个苹果分给5个人，每人0个，所以0÷5=0",
              "5÷0：5个苹果分给0个人？没有人怎么分？所以5÷0无意义"
            ],
            "answer": "0÷5=0；5÷0无意义（不能除以0）"
          },
          "mistakes": [
            {
              "wrong": "认为0÷5=5或5÷0=0",
              "correct": "0÷5=0（分出去的是0），5÷0无意义（不能除以0）"
            }
          ],
          "memory_tip": "零除谁都是零，谁除零都不行",
          "emotion_hook": "90%的大人都做错！你来试试？",
          "trap_point": "0在除号前面和后面的含义完全不同",
          "related": {
            "prerequisite": "见同年级标准卡片包",
            "next": "见同年级标准卡片包"
          }
        },
        {
          "card_id": "T1-02",
          "full_id": "数学-三下-T1-02",
          "title": "先乘除后加减",
          "type": "陷阱卡",
          "difficulty": 3,
          "importance": 5,
          "definition": "混合运算中，先算乘除后算加减",
          "core_points": [
            "没有括号时，先乘除后加减",
            "有括号时，先算括号里的",
            "同级运算从左到右"
          ],
          "example": {
            "question": "840 - 840 ÷ 4 = ?",
            "steps": [
              "先算除法：840 ÷ 4 = 210",
              "再算减法：840 - 210 = 630",
              "⚠️ 不是 (840-840) ÷ 4 = 0！"
            ],
            "answer": "630（不是0！）"
          },
          "mistakes": [
            {
              "wrong": "从左到右算：840-840=0, 0÷4=0",
              "correct": "先算除法840÷4=210，再算840-210=630"
            }
          ],
          "memory_tip": "先乘除后加减，别被顺序骗",
          "emotion_hook": "这道题很多家长也做错了！",
          "trap_point": "容易从左到右依次计算，忘了先乘除",
          "related": {
            "prerequisite": "见同年级标准卡片包",
            "next": "见同年级标准卡片包"
          }
        },
        {
          "card_id": "T1-03",
          "full_id": "数学-三下-T1-03",
          "title": "余数必须小于除数",
          "type": "陷阱卡",
          "difficulty": 3,
          "importance": 4,
          "definition": "有余数除法中，余数必须小于除数",
          "core_points": [
            "如果余数等于或大于除数，说明商不够大",
            "可以用 商×除数+余数=被除数 来验证"
          ],
          "example": {
            "question": "25 ÷ 4 = ? ... ?",
            "steps": [
              "25 ÷ 4 = 6 ... 1 ✓（因为1<4）",
              "⚠️ 不是 25 ÷ 4 = 5 ... 5 ✗（因为5>4，余数不能>=除数！）"
            ],
            "answer": "25÷4=6...1"
          },
          "mistakes": [
            {
              "wrong": "写成25÷4=5...5（余数5大于除数4）",
              "correct": "25÷4=6...1（余数1小于除数4）"
            }
          ],
          "memory_tip": "余数小小不超除，超了就要加一商",
          "emotion_hook": "余数比除数大？大错特错！",
          "trap_point": "商算小了导致余数超过了除数",
          "related": {
            "prerequisite": "见同年级标准卡片包",
            "next": "见同年级标准卡片包"
          }
        },
        {
          "card_id": "T1-04",
          "full_id": "数学-三下-T1-04",
          "title": "周长和面积别搞混",
          "type": "陷阱卡",
          "difficulty": 4,
          "importance": 5,
          "definition": "周长是围一圈的总长度（单位：厘米/米），面积是覆盖的大小（单位：平方厘米/平方米），两者概念和单位完全不同",
          "core_points": [
            "周长 = 所有边长之和（长方形：(长+宽)×2）",
            "面积 = 长×宽（长方形）或 边长×边长（正方形）",
            "周长相同的图形，面积可以不同！",
            "单位不能混：cm是长度单位，cm²是面积单位"
          ],
          "example": {
            "question": "一个长方形，长6cm，宽4cm。求它的周长和面积。",
            "steps": [
              "周长 = (6+4)×2 = 20cm",
              "面积 = 6×4 = 24cm²",
              "⚠️ 周长的单位是cm，面积的单位是cm²，不能搞混！",
              "⚠️ 周长是加法思维（边长相加），面积是乘法思维（长×宽）"
            ],
            "answer": "周长20cm，面积24cm²"
          },
          "mistakes": [
            {
              "wrong": "求周长写成6×4=24cm，求面积写成(6+4)×2=20cm²",
              "correct": "周长用加：(6+4)×2=20cm；面积用乘：6×4=24cm²"
            },
            {
              "wrong": "面积写成24cm（忘了写平方）",
              "correct": "面积单位必须带²，写成24cm²"
            }
          ],
          "memory_tip": "周长跑一圈用加法，面积铺满地用乘法。长度用cm，面积带个²！",
          "emotion_hook": "周长和面积到底谁大？90%孩子分不清！",
          "trap_point": "把周长公式和面积公式搞反，或者单位写错（cm和cm²混用）",
          "related": {
            "prerequisite": "见同年级标准卡片包",
            "next": "见同年级标准卡片包"
          }
        }
      ]
