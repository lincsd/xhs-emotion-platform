          "difficulty": 5,
          "importance": 5,
          "definition": "感应电动势ε=nΔΦ/Δt=BLv(导体切割)。楞次定律判断感应电流方向：感应电流的磁场阻碍引起感应电流的磁通量变化。",
          "core_points": [
            "ε=nΔΦ/Δt (法拉第定律，适用于一切情况)",
            "ε=BLv (导体切割磁感线)",
            "楞次定律: 增反减同(阻碍变化)",
            "右手定则: 大拇指=运动方向, 四指=电流方向"
          ],
          "example": {
            "question": "线圈中磁通量从0.2Wb在0.1s内变为0，ε=？(n=100匝)",
            "steps": [
              "1. ΔΦ=0.2-0=0.2Wb",
              "2. ε=nΔΦ/Δt=100×0.2/0.1",
              "3. ε=200V"
            ],
            "answer": "ε=200V"
          },
          "mistakes": [
